<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DynamicIsland"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="560"
        Height="70"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ══════ 缓动函数 ══════ -->
        <CubicEase     x:Key="EaseOut"      EasingMode="EaseOut"/>
        <CubicEase     x:Key="EaseInOut"    EasingMode="EaseInOut"/>
        <BackEase      x:Key="BounceBack"   EasingMode="EaseOut"  Amplitude="0.4"/>
        <BackEase      x:Key="SpringOpen"   EasingMode="EaseOut"  Amplitude="0.3"/>
        <BackEase      x:Key="SpringClose"  EasingMode="EaseOut"  Amplitude="0.2"/>
        <ElasticEase   x:Key="Elastic"      EasingMode="EaseOut"  Oscillations="1" Springiness="5"/>

        <!-- ══════ 入场动画 ══════ -->
        <Storyboard x:Key="SlideInAnimation">
            <DoubleAnimation
                Storyboard.TargetName="IslandContainer"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="-60" To="0" Duration="0:0:0.6"
                EasingFunction="{StaticResource BounceBack}"/>
            <DoubleAnimation
                Storyboard.TargetName="IslandContainer"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.4"
                EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>

        <!-- ══════ 展开动画 ══════ -->
        <Storyboard x:Key="ExpandAnimation">
            <DoubleAnimation Storyboard.TargetName="IslandBorder"
                Storyboard.TargetProperty="Height"
                To="44" Duration="0:0:0.6"
                EasingFunction="{StaticResource Elastic}"/>
            <DoubleAnimation Storyboard.TargetName="CompactDot"
                Storyboard.TargetProperty="Opacity"
                To="0" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="CoverScale"
                Storyboard.TargetProperty="ScaleX"
                To="1" Duration="0:0:0.5" BeginTime="0:0:0.1"
                EasingFunction="{StaticResource BounceBack}"/>
            <DoubleAnimation Storyboard.TargetName="CoverScale"
                Storyboard.TargetProperty="ScaleY"
                To="1" Duration="0:0:0.5" BeginTime="0:0:0.1"
                EasingFunction="{StaticResource BounceBack}"/>
            <DoubleAnimation Storyboard.TargetName="TextContent"
                Storyboard.TargetProperty="Opacity"
                To="1" Duration="0:0:0.4" BeginTime="0:0:0.2"
                EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="SpectrumPanel"
                Storyboard.TargetProperty="Opacity"
                To="1" Duration="0:0:0.4" BeginTime="0:0:0.3"
                EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>

        <!-- ══════ 收缩动画 ══════ -->
        <Storyboard x:Key="ContractAnimation">
            <DoubleAnimation Storyboard.TargetName="SpectrumPanel"
                Storyboard.TargetProperty="Opacity"
                To="0" Duration="0:0:0.12"/>
            <DoubleAnimation Storyboard.TargetName="TextContent"
                Storyboard.TargetProperty="Opacity"
                To="0" Duration="0:0:0.12" BeginTime="0:0:0.03"/>
            <DoubleAnimation Storyboard.TargetName="CoverScale"
                Storyboard.TargetProperty="ScaleX"
                To="0" Duration="0:0:0.2" BeginTime="0:0:0.05"
                EasingFunction="{StaticResource EaseInOut}"/>
            <DoubleAnimation Storyboard.TargetName="CoverScale"
                Storyboard.TargetProperty="ScaleY"
                To="0" Duration="0:0:0.2" BeginTime="0:0:0.05"
                EasingFunction="{StaticResource EaseInOut}"/>
            <DoubleAnimation Storyboard.TargetName="IslandBorder"
                Storyboard.TargetProperty="Height"
                To="32" Duration="0:0:0.35" BeginTime="0:0:0.1"
                EasingFunction="{StaticResource SpringClose}"/>
            <DoubleAnimation Storyboard.TargetName="CompactDot"
                Storyboard.TargetProperty="Opacity"
                To="1" Duration="0:0:0.2" BeginTime="0:0:0.35"
                EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>

        <!-- ══════ Hover / Press / Release ══════ -->
        <Storyboard x:Key="HoverEnterAnimation">
            <DoubleAnimation Storyboard.TargetName="IslandScale"
                Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.25"
                EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="IslandScale"
                Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.25"
                EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>
        <Storyboard x:Key="HoverLeaveAnimation">
            <DoubleAnimation Storyboard.TargetName="IslandScale"
                Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.3"
                EasingFunction="{StaticResource BounceBack}"/>
            <DoubleAnimation Storyboard.TargetName="IslandScale"
                Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.3"
                EasingFunction="{StaticResource BounceBack}"/>
        </Storyboard>
        <Storyboard x:Key="PressAnimation">
            <DoubleAnimation Storyboard.TargetName="IslandScale"
                Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.1"
                EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="IslandScale"
                Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.1"
                EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>
        <Storyboard x:Key="ReleaseAnimation">
            <DoubleAnimation Storyboard.TargetName="IslandScale"
                Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.35"
                EasingFunction="{StaticResource BounceBack}"/>
            <DoubleAnimation Storyboard.TargetName="IslandScale"
                Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.35"
                EasingFunction="{StaticResource BounceBack}"/>
        </Storyboard>

        <!-- ══════ 麦克风岛分裂 ══════ -->
        <Storyboard x:Key="MicSplitInAnimation">
            <DoubleAnimation Storyboard.TargetName="MicIsland"
                Storyboard.TargetProperty="Width"
                From="0" To="44" Duration="0:0:0.4"
                EasingFunction="{StaticResource Elastic}"/>
            <ThicknessAnimation Storyboard.TargetName="MicIsland"
                Storyboard.TargetProperty="Margin"
                From="0,0,0,0" To="8,0,0,0" Duration="0:0:0.35"
                EasingFunction="{StaticResource BounceBack}"/>
            <DoubleAnimation Storyboard.TargetName="MicIsland"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.25"
                EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="MicIconScale"
                Storyboard.TargetProperty="ScaleX"
                From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.15"
                EasingFunction="{StaticResource BounceBack}"/>
            <DoubleAnimation Storyboard.TargetName="MicIconScale"
                Storyboard.TargetProperty="ScaleY"
                From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.15"
                EasingFunction="{StaticResource BounceBack}"/>
        </Storyboard>
        <Storyboard x:Key="MicSplitOutAnimation">
            <DoubleAnimation Storyboard.TargetName="MicIconScale"
                Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.15"
                EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="MicIconScale"
                Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.15"
                EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="MicIsland"
                Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.3" BeginTime="0:0:0.1"
                EasingFunction="{StaticResource EaseInOut}"/>
            <ThicknessAnimation Storyboard.TargetName="MicIsland"
                Storyboard.TargetProperty="Margin" To="0,0,0,0" Duration="0:0:0.3" BeginTime="0:0:0.1"
                EasingFunction="{StaticResource EaseInOut}"/>
            <DoubleAnimation Storyboard.TargetName="MicIsland"
                Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" BeginTime="0:0:0.15"/>
        </Storyboard>


        <!-- ══════ 通知滚入：歌曲向上移出 + 通知从下滚入 ══════ -->
        <Storyboard x:Key="NotifScrollInAnimation">
            <DoubleAnimation Storyboard.TargetName="MusicTranslate"
                Storyboard.TargetProperty="Y"
                To="-40" Duration="0:0:0.35"
                EasingFunction="{StaticResource EaseInOut}"/>
            <DoubleAnimation Storyboard.TargetName="TextContent"
                Storyboard.TargetProperty="Opacity"
                To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="CoverScale"
                Storyboard.TargetProperty="ScaleX"
                To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="CoverScale"
                Storyboard.TargetProperty="ScaleY"
                To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="SpectrumPanel"
                Storyboard.TargetProperty="Opacity"
                To="0" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="NotifTranslate"
                Storyboard.TargetProperty="Y"
                From="40" To="0" Duration="0:0:0.35" BeginTime="0:0:0.1"
                EasingFunction="{StaticResource BounceBack}"/>
            <DoubleAnimation Storyboard.TargetName="NotificationContent"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.15"/>
        </Storyboard>

        <!-- ══════ 通知滚出：通知向下移出 + 歌曲从上滚回 ══════ -->
        <Storyboard x:Key="NotifScrollOutAnimation">
            <DoubleAnimation Storyboard.TargetName="NotifTranslate"
                Storyboard.TargetProperty="Y"
                To="40" Duration="0:0:0.3"
                EasingFunction="{StaticResource EaseInOut}"/>
            <DoubleAnimation Storyboard.TargetName="NotificationContent"
                Storyboard.TargetProperty="Opacity"
                To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="MusicTranslate"
                Storyboard.TargetProperty="Y"
                From="-40" To="0" Duration="0:0:0.35" BeginTime="0:0:0.1"
                EasingFunction="{StaticResource BounceBack}"/>
            <DoubleAnimation Storyboard.TargetName="TextContent"
                Storyboard.TargetProperty="Opacity"
                To="1" Duration="0:0:0.25" BeginTime="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="CoverScale"
                Storyboard.TargetProperty="ScaleX"
                To="1" Duration="0:0:0.3" BeginTime="0:0:0.15"
                EasingFunction="{StaticResource BounceBack}"/>
            <DoubleAnimation Storyboard.TargetName="CoverScale"
                Storyboard.TargetProperty="ScaleY"
                To="1" Duration="0:0:0.3" BeginTime="0:0:0.15"
                EasingFunction="{StaticResource BounceBack}"/>
            <DoubleAnimation Storyboard.TargetName="SpectrumPanel"
                Storyboard.TargetProperty="Opacity"
                To="1" Duration="0:0:0.2" BeginTime="0:0:0.25"/>
        </Storyboard>

        <!-- ══════ 来电展开动画：音乐滑出 + 来电内容淡入 ══════ -->
        <Storyboard x:Key="CallExpandAnimation">
            <DoubleAnimation Storyboard.TargetName="MusicTranslate"
                Storyboard.TargetProperty="Y"
                To="-40" Duration="0:0:0.3"
                EasingFunction="{StaticResource EaseInOut}"/>
            <DoubleAnimation Storyboard.TargetName="TextContent"
                Storyboard.TargetProperty="Opacity"
                To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="CoverScale"
                Storyboard.TargetProperty="ScaleX"
                To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="CoverScale"
                Storyboard.TargetProperty="ScaleY"
                To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="SpectrumPanel"
                Storyboard.TargetProperty="Opacity"
                To="0" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="CallContent"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.3" BeginTime="0:0:0.2"
                EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>

        <!-- ══════ 来电收缩动画：来电淡出 + 音乐滑回 ══════ -->
        <Storyboard x:Key="CallCollapseAnimation">
            <DoubleAnimation Storyboard.TargetName="CallContent"
                Storyboard.TargetProperty="Opacity"
                To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="MusicTranslate"
                Storyboard.TargetProperty="Y"
                From="-40" To="0" Duration="0:0:0.35" BeginTime="0:0:0.15"
                EasingFunction="{StaticResource BounceBack}"/>
            <DoubleAnimation Storyboard.TargetName="TextContent"
                Storyboard.TargetProperty="Opacity"
                To="1" Duration="0:0:0.25" BeginTime="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="CoverScale"
                Storyboard.TargetProperty="ScaleX"
                To="1" Duration="0:0:0.3" BeginTime="0:0:0.2"
                EasingFunction="{StaticResource BounceBack}"/>
            <DoubleAnimation Storyboard.TargetName="CoverScale"
                Storyboard.TargetProperty="ScaleY"
                To="1" Duration="0:0:0.3" BeginTime="0:0:0.2"
                EasingFunction="{StaticResource BounceBack}"/>
            <DoubleAnimation Storyboard.TargetName="SpectrumPanel"
                Storyboard.TargetProperty="Opacity"
                To="1" Duration="0:0:0.2" BeginTime="0:0:0.3"/>
        </Storyboard>

        <!-- ══════ 控制面板展开 ══════ -->
        <Storyboard x:Key="PanelOpenAnimation">
            <DoubleAnimation Storyboard.TargetName="IslandBorder"
                Storyboard.TargetProperty="Height"
                To="148" Duration="0:0:0.4"
                EasingFunction="{StaticResource SpringOpen}"/>
            <DoubleAnimation Storyboard.TargetName="MusicControlPanel"
                Storyboard.TargetProperty="Opacity"
                To="1" Duration="0:0:0.3" BeginTime="0:0:0.15"
                EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>

        <!-- ══════ 控制面板收回 ══════ -->
        <Storyboard x:Key="PanelCloseAnimation">
            <DoubleAnimation Storyboard.TargetName="MusicControlPanel"
                Storyboard.TargetProperty="Opacity"
                To="0" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="IslandBorder"
                Storyboard.TargetProperty="Height"
                To="44" Duration="0:0:0.35" BeginTime="0:0:0.1"
                EasingFunction="{StaticResource SpringClose}"/>
        </Storyboard>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════ -->
    <!--                   主布局                       -->
    <!-- ══════════════════════════════════════════════ -->
    <Grid>
        <Border x:Name="IslandContainer"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,6,0,0"
                Opacity="0"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TranslateTransform Y="-60"/>
            </Border.RenderTransform>

            <StackPanel Orientation="Horizontal">

                <!-- ═══════ 灵动岛主体 ═══════ -->
                <Border x:Name="IslandBorder"
                        CornerRadius="22"
                        Width="50" Height="32"
                        ClipToBounds="True"
                        Cursor="Hand"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="IslandScale" ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>

                    <Grid>
                        <!-- 半透明底色（主题可换） -->
                        <Border x:Name="IslandBg" Background="#CC1A1A1A" CornerRadius="22"/>

                        <!-- 顶部高光条 -->
                        <Border CornerRadius="22" ClipToBounds="True">
                            <Border Height="1" VerticalAlignment="Top" Margin="20,0,20,0" Opacity="0.1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="White"       Offset="0.5"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>

                        <!-- 玻璃边缘微光 -->
                        <Border CornerRadius="22" BorderBrush="#18FFFFFF" BorderThickness="0.8"/>

                        <!-- 紧凑态小圆点 -->
                        <Ellipse x:Name="CompactDot"
                                 Width="10" Height="10"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Opacity="1">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#88FFFFFF" Offset="0"/>
                                    <GradientStop Color="#33FFFFFF" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- 展开态内容 -->
                        <Grid VerticalAlignment="Top" Margin="14,0"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="MusicTranslate" Y="0"/>
                            </Grid.RenderTransform>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0：封面 + 歌名 + 频谱 -->
                            <Grid Grid.Row="0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 封面 -->
                                <Border Grid.Column="0" Width="30" Height="30"
                                        CornerRadius="15" Margin="0,0,10,0"
                                        ClipToBounds="True"
                                        VerticalAlignment="Center"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="CoverScale" ScaleX="0" ScaleY="0"/>
                                    </Border.RenderTransform>
                                    <Border.Background>
                                        <ImageBrush x:Name="CoverImage"
                                                    ImageSource="pack://application:,,,/Resources/default_cover.png"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>

                                <!-- 文本区域：歌曲信息 -->
                                <Grid Grid.Column="1" x:Name="TextContent" Opacity="0"
                                      VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <StackPanel x:Name="InfoPanel" VerticalAlignment="Center">
                                        <TextBlock x:Name="TitleText"
                                                   Foreground="White"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   FontFamily="Segoe UI Variable, Segoe UI"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextOptions.TextRenderingMode="ClearType"
                                                   TextOptions.TextFormattingMode="Display"/>
                                        <TextBlock x:Name="SubtitleText"
                                                   Foreground="#99FFFFFF"
                                                   FontSize="11"
                                                   FontFamily="Segoe UI Variable, Segoe UI"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextOptions.TextRenderingMode="ClearType"
                                                   TextOptions.TextFormattingMode="Display"/>
                                    </StackPanel>
                                </Grid>



                                <!-- 频谱条 -->
                                <StackPanel Grid.Column="2" x:Name="SpectrumPanel"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0"
                                            Opacity="0"/>
                            </Grid>

                            <!-- Row 1：音乐控制面板 -->
                            <StackPanel x:Name="MusicControlPanel" Grid.Row="1"
                                        Opacity="0" Margin="0,2,0,4"
                                        IsHitTestVisible="False"
                                        MouseLeftButtonDown="OnControlPanelClick"
                                        MouseLeftButtonUp="OnControlPanelClick">

                                <!-- 歌词显示 -->
                                <TextBlock x:Name="LyricLine"
                                           Text=""
                                           Foreground="#CCFFFFFF"
                                           FontSize="12"
                                           FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="4,2,4,6"
                                           MaxWidth="260"
                                           TextOptions.TextRenderingMode="ClearType"
                                           TextOptions.TextFormattingMode="Display"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="LyricLineTranslate" Y="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>

                                <!-- 进度条 -->
                                <Grid Margin="4,0,4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="CurrentTimeText" Grid.Column="0"
                                               Text="0:00" Foreground="#99FFFFFF" FontSize="9.5"
                                               VerticalAlignment="Center" Margin="0,0,6,0"
                                               FontFamily="Segoe UI Variable, Segoe UI"
                                               TextOptions.TextRenderingMode="ClearType"/>

                                    <Grid Grid.Column="1" Height="3" VerticalAlignment="Center"
                                          x:Name="ProgressBarContainer" Cursor="Hand"
                                          Background="Transparent"
                                          MouseLeftButtonDown="OnProgressBarClick">
                                        <Border Background="#33FFFFFF" CornerRadius="1.5"/>
                                        <Border x:Name="ProgressFill"
                                                Background="White" CornerRadius="1.5"
                                                HorizontalAlignment="Left" Width="0"/>
                                    </Grid>

                                    <TextBlock x:Name="TotalTimeText" Grid.Column="2"
                                               Text="0:00" Foreground="#99FFFFFF" FontSize="9.5"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               FontFamily="Segoe UI Variable, Segoe UI"
                                               TextOptions.TextRenderingMode="ClearType"/>
                                </Grid>

                                <!-- 控制按钮 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                    <!-- 上一首 -->
                                    <Border Width="36" Height="36" CornerRadius="18"
                                            Cursor="Hand" Background="Transparent"
                                            MouseLeftButtonUp="OnPreviousTrack">
                                        <Canvas Width="16" Height="16"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Rectangle Width="2.5" Height="14" Canvas.Top="1"
                                                       Fill="#CCFFFFFF" RadiusX="1" RadiusY="1"/>
                                            <Path Data="M 14,1 L 5,8 L 14,15 Z" Fill="#CCFFFFFF"/>
                                        </Canvas>
                                    </Border>

                                    <!-- 播放/暂停 -->
                                    <Border Width="42" Height="42" CornerRadius="21"
                                            Cursor="Hand" Background="#22FFFFFF" Margin="20,0"
                                            MouseLeftButtonUp="OnPlayPause">
                                        <Grid>
                                            <Canvas x:Name="PauseIcon" Width="18" Height="18"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Canvas.Left="3" Width="4" Height="18"
                                                           Fill="White" RadiusX="1" RadiusY="1"/>
                                                <Rectangle Canvas.Left="11" Width="4" Height="18"
                                                           Fill="White" RadiusX="1" RadiusY="1"/>
                                            </Canvas>
                                            <Path x:Name="PlayIcon"
                                                  Data="M 6,2 L 20,11 L 6,20 Z"
                                                  Fill="#1DB954" Stretch="Uniform"
                                                  Width="18" Height="18"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>

                                    <!-- 下一首 -->
                                    <Border Width="36" Height="36" CornerRadius="18"
                                            Cursor="Hand" Background="Transparent"
                                            MouseLeftButtonUp="OnNextTrack">
                                        <Canvas Width="16" Height="16"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M 2,1 L 11,8 L 2,15 Z" Fill="#CCFFFFFF"/>
                                            <Rectangle Width="2.5" Height="14" Canvas.Left="13" Canvas.Top="1"
                                                       Fill="#CCFFFFFF" RadiusX="1" RadiusY="1"/>
                                        </Canvas>
                                    </Border>

                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 通知显示层 -->
                        <Grid x:Name="NotificationContent"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Margin="14,0"
                              Opacity="0"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="NotifTranslate" Y="0"/>
                            </Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 应用图标占位：显示 App 首字母 -->
                            <Border x:Name="NotifIconBg" Grid.Column="0" Width="26" Height="26"
                                    CornerRadius="13" Margin="0,0,8,0"
                                    Background="#3399FF">
                                <TextBlock x:Name="NotifIconText"
                                           Text="Q"
                                           Foreground="White"
                                           FontSize="14" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- 消息内容 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="NotifTitle"
                                           Foreground="White"
                                           FontSize="12" FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable, Segoe UI"
                                           TextTrimming="CharacterEllipsis"
                                           TextOptions.TextRenderingMode="ClearType"
                                           TextOptions.TextFormattingMode="Display"/>
                                <TextBlock x:Name="NotifContent"
                                           Foreground="#99FFFFFF"
                                           FontSize="10.5"
                                           FontFamily="Segoe UI Variable, Segoe UI"
                                           TextTrimming="CharacterEllipsis"
                                           TextOptions.TextRenderingMode="ClearType"
                                           TextOptions.TextFormattingMode="Display"/>
                            </StackPanel>
                        </Grid>
                        <!-- 来电显示层 -->
                        <Grid x:Name="CallContent"
                              Opacity="0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"
                              Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 来电人头像（首字母圆形） -->
                            <Border Grid.Column="0" x:Name="CallAvatarBg"
                                    Width="32" Height="32" CornerRadius="16"
                                    Background="#4CAF50" Margin="0,0,8,0">
                                <TextBlock x:Name="CallAvatarText"
                                           Text="?" Foreground="White"
                                           FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- 来电信息 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="CallNameText"
                                           Text="来电"
                                           Foreground="White"
                                           FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           TextOptions.TextRenderingMode="ClearType"
                                           TextOptions.TextFormattingMode="Display"/>
                                <TextBlock x:Name="CallStatusText"
                                           Text="来电中..."
                                           Foreground="#99FFFFFF"
                                           FontSize="10"
                                           TextOptions.TextRenderingMode="ClearType"
                                           TextOptions.TextFormattingMode="Display"/>
                            </StackPanel>

                            <!-- 接听 / 挂断按钮组 -->
                            <StackPanel Grid.Column="2" x:Name="CallButtonPanel"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <!-- 挂断按钮 -->
                                <Border x:Name="DeclineBtn"
                                        Width="36" Height="36" CornerRadius="18"
                                        Background="#FF3B30" Cursor="Hand" Margin="0,0,8,0"
                                        MouseLeftButtonUp="OnDeclineCall"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="DeclineBtnScale" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <TextBlock Text="✕" Foreground="White"
                                               FontSize="16" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- 接听按钮 -->
                                <Border x:Name="AcceptBtn"
                                        Width="36" Height="36" CornerRadius="18"
                                        Background="#34C759" Cursor="Hand"
                                        MouseLeftButtonUp="OnAcceptCall"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="AcceptBtnScale" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <TextBlock Text="✓" Foreground="White"
                                               FontSize="16" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                    </Grid>
                </Border>

                <!-- ═══════ 麦克风岛 ═══════ -->
                <Border x:Name="MicIsland"
                        Background="#CC1A1A1A"
                        CornerRadius="22"
                        Height="44" Width="0" Opacity="0"
                        ClipToBounds="True"
                        BorderBrush="#18FFFFFF" BorderThickness="0.8">
                    <Viewbox Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
                        <Viewbox.RenderTransform>
                            <ScaleTransform x:Name="MicIconScale" ScaleX="0" ScaleY="0"/>
                        </Viewbox.RenderTransform>
                        <Canvas Width="24" Height="24">
                            <Path Fill="#22DD44"
                                  Data="M12,2 C13.66,2 15,3.34 15,5 L15,11 C15,12.66 13.66,14 12,14
                                        C10.34,14 9,12.66 9,11 L9,5 C9,3.34 10.34,2 12,2 Z
                                        M19,11 L17,11 C17,13.76 14.76,16 12,16
                                        C9.24,16 7,13.76 7,11 L5,11
                                        C5,14.53 7.61,17.44 11,17.93 L11,21 L13,21 L13,17.93
                                        C16.39,17.44 19,14.53 19,11 Z"/>
                        </Canvas>
                    </Viewbox>
                </Border>

            </StackPanel>
        </Border>

    </Grid>
</Window>